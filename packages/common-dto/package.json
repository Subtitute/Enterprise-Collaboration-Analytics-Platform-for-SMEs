{
  "name": "@app/common-dto",
  "version": "0.1.0",
  "private": true,
  "description": "Shared event schema, DTOs and enums dung chung cho toan bo microservices (Technical_Spec.md muc 4.3, muc 7)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "jest"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "setupFiles": ["reflect-metadata"],
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": { "statements": 15, "branches": 0, "functions": 30, "lines": 10 }
    },
    "testEnvironment": "node"
  }
}
