NODE_ENV=development
PORT=3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

JWT_ACCESS_SECRET=change_me_access_secret_dev_only

# Bi mat dung chung giua Gateway va cac service phia sau (Technical_Spec.md muc 6, bo sung 21/07/2026) -
# chong client goi thang vao service (bo qua Gateway) tu khai header context de gia mao danh tinh.
INTERNAL_SHARED_SECRET=dev-shared-secret-change-me

# Danh sach origin duoc phep goi Gateway, phan tach boi dau phay (Technical_Spec.md muc 9).
# Mac dinh fallback ve cong dev cua Vite (apps/web/vite.config.ts) neu bo trong.
CORS_ORIGIN=http://localhost:5173

IAM_SERVICE_URL=http://localhost:3001
PROJECT_TASK_SERVICE_URL=http://localhost:3002
DOCUMENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
