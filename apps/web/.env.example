# Trong dev, Vite dev-server proxy chuyen tiep /api/v1 va /ws sang Gateway (localhost:3000) - xem vite.config.ts.
# Trong production (Docker), Nginx dong vai tro proxy tuong tu - xem nginx.conf.
# Vi vay gia tri mac dinh luon la duong dan tuong doi (relative path), khong phai URL tuyet doi.
VITE_API_BASE_URL=/api/v1
VITE_WS_NOTIFICATION_URL=/ws/notifications
VITE_WS_ANALYTICS_URL=/ws/analytics
