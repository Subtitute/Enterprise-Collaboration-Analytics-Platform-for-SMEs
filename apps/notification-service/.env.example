NODE_ENV=development
PORT=3004

# 26/08/2026: doi tu 1 bien MONGO_URI ghep san sang 5 bien RIENG LE (dong bo mau Postgres cua
# cac service khac, vd DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME cua iam-service) - configuration.ts
# tu xay dung URI va encodeURIComponent() rieng MONGO_USER/MONGO_PASSWORD truoc khi noi vao chuoi,
# tranh mat khau chua ky tu dac biet (@ : / ? # [ ] %) lam hong cu phap URI (xem configuration.ts).
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=notification_root
MONGO_PASSWORD=notification_password
MONGO_DATABASE=notification_db

KAFKA_BROKER=localhost:9092

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

JWT_ACCESS_SECRET=change_me_access_secret_dev_only
