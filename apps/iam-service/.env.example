NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5433
DB_NAME=iam_db
DB_USER=iam_user
DB_PASSWORD=iam_password

KAFKA_BROKER=localhost:9092

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bi mat dung chung giua Gateway va cac service phia sau (Technical_Spec.md muc 6, bo sung 21/07/2026) -
# chong client goi thang vao service (bo qua Gateway) tu khai header context de gia mao danh tinh.
INTERNAL_SHARED_SECRET=dev-shared-secret-change-me

# Danh sach origin duoc phep goi IAM Service, phan tach boi dau phay (Technical_Spec.md muc 9).
CORS_ORIGIN=http://localhost:5173
