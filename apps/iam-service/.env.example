NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5433
DB_NAME=iam_db
DB_USER=iam_user
DB_PASSWORD=iam_password

KAFKA_BROKER=localhost:9092

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Secret RIENG cho token "Quen mat khau" - KHONG dung chung voi 2 secret o tren (bo sung 15/09/2026).
JWT_RESET_SECRET=change_me_reset_secret_dev_only
JWT_RESET_EXPIRES_IN=30m

# "Quen mat khau" - gui email that qua SMTP (bo sung 15/09/2026). Mac dinh tro toi container
# `mailhog` (infra/docker-compose.yml) - SMTP gia lap cho dev/demo, xem giao dien web tai
# http://localhost:8025 de doc lai email da "gui", KHONG can tai khoan that. Doi SMTP_HOST/PORT/
# USER/PASSWORD sang nha cung cap that (Gmail app-password, SendGrid...) khi trien khai that.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ecap-demo.local

# URL goc cua frontend - dung de dung link dat lai mat khau gui qua email.
FRONTEND_URL=http://localhost:5173

# Bi mat dung chung giua Gateway va cac service phia sau (Technical_Spec.md muc 6, bo sung 21/07/2026) -
# chong client goi thang vao service (bo qua Gateway) tu khai header context de gia mao danh tinh.
INTERNAL_SHARED_SECRET=dev-shared-secret-change-me

# Danh sach origin duoc phep goi IAM Service, phan tach boi dau phay (Technical_Spec.md muc 9).
CORS_ORIGIN=http://localhost:5173
