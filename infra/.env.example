# Copy this file to `infra/.env` before running `docker compose up`.
# Theo Technical_Spec.md muc 8 - Trien khai & ha tang.
#
# 22/07/2026: bo sung canh bao nay - phat hien qua code review toan du an: JWT_ACCESS_SECRET/
# JWT_REFRESH_SECRET va INTERNAL_SHARED_SECRET ben duoi da co dau hieu "chi danh cho dev" ro
# rang (hau to _dev_only, comment "PHAI doi gia tri nay"), nhung TOAN BO gia tri con lai trong
# file nay (mat khau Postgres/Mongo/Redis/MinIO) lai trong giong het gia tri "that", de khien
# nguoi trien khai copy nguyen file nay sang production ma khong nhan ra can doi mat khau.
# TOAN BO gia tri trong file nay CHI la vi du cho moi truong dev cuc bo (docker compose o may
# ca nhan) - PHAI thay doi TAT CA truoc khi trien khai ra bat ky moi truong nao khac dev.

# ---- Postgres: IAM Service ----
POSTGRES_IAM_DB=iam_db
POSTGRES_IAM_USER=iam_user
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
POSTGRES_IAM_PASSWORD=iam_password

# ---- Postgres: Project & Task Service ----
POSTGRES_PT_DB=project_task_db
POSTGRES_PT_USER=pt_user
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
POSTGRES_PT_PASSWORD=pt_password

# ---- Postgres: Document Service ----
POSTGRES_DOC_DB=document_db
POSTGRES_DOC_USER=doc_user
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
POSTGRES_DOC_PASSWORD=doc_password

# ---- Postgres: CRM-lite Service (bo sung 04/08/2026) ----
POSTGRES_CRM_DB=crm_db
POSTGRES_CRM_USER=crm_user
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
POSTGRES_CRM_PASSWORD=crm_password

# ---- Postgres: HRM-lite Service (bo sung 05/08/2026) ----
POSTGRES_HRM_DB=hrm_db
POSTGRES_HRM_USER=hrm_user
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
POSTGRES_HRM_PASSWORD=hrm_password

# ---- TimescaleDB: Analytics Service ----
TIMESCALE_DB=analytics_db
TIMESCALE_USER=analytics_user
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
TIMESCALE_PASSWORD=analytics_password

# ---- MongoDB: Notification Service ----
# 26/08/2026 (fix audit - Major): 3 bien nay phuc vu 2 muc dich - (1) MONGO_INITDB_ROOT_USERNAME/
# PASSWORD la bien CHUAN cua chinh image mongo:7 dung khoi tao user root luc container lan dau
# chay (xem docker-compose.yml, service `mongodb`), va (2) ca 3 bien nay gio con duoc docker-
# compose.yml TRUYEN TIEP thanh MONGO_USER/MONGO_PASSWORD/MONGO_DATABASE (5 bien rieng le, kem
# MONGO_HOST/MONGO_PORT) cho notification-service TU XAY DUNG MONGO_URI (co encodeURIComponent())
# thay vi nhan 1 MONGO_URI ghep san khong encode nhu truoc - mat khau chua ky tu dac biet (@ : /
# ? # [ ] %) khong con lam hong cu phap URI. Doi mat khau o day van chi can sua 1 noi DUY NHAT.
MONGO_INITDB_ROOT_USERNAME=notification_root
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
MONGO_INITDB_ROOT_PASSWORD=notification_password
MONGO_DATABASE=notification_db

# ---- Redis ----
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
REDIS_PASSWORD=redis_password

# ---- MinIO (Document storage) ----
MINIO_ROOT_USER=minio_admin
# 22/07/2026: mat khau dev-only - PHAI doi truoc khi dung that (xem canh bao dau file).
MINIO_ROOT_PASSWORD=minio_password123
MINIO_BUCKET=documents
# 05/08/2026: bucket rieng cho anh cham cong HRM-lite (Technical_Spec.md muc 17) - tach biet khoi
# bucket tai lieu chung o tren, giu che do private nhu nhau.
MINIO_HRM_BUCKET=hrm-attendance
# Host:port ma trinh duyet cua client resolve duoc de tai file qua presigned URL
# (khac voi hostname noi bo "minio" dung giua cac container) - xem Technical_Spec.md muc 8.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9010

# 13/08/2026: toa do van phong cho co "on-site"/"off-site" cua cham cong (Technical_Spec.md muc
# 17) - de trong nghia la TAT tinh nang nay hoan toan (khong tinh toan, khong loi). Dien toa do
# that (vd lay tu Google Maps: chuot phai vao diem tren ban do -> copy toa do) khi co van phong
# that can bat tinh nang nay.
OFFICE_LATITUDE=
OFFICE_LONGITUDE=
OFFICE_GEOFENCE_RADIUS_METERS=200

# ---- Kafka ----
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# ---- JWT (shared secret HS256 between Gateway va IAM Service) ----
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- "Quen mat khau" (bo sung 15/09/2026, phan hoi GVHD muc 4) ----
# Secret RIENG cho token dat lai mat khau - PHAI khac JWT_ACCESS_SECRET/JWT_REFRESH_SECRET o tren
# (xem chu thich apps/iam-service/src/entities/password-reset-token.entity.ts).
JWT_RESET_SECRET=change_me_reset_secret_dev_only
JWT_RESET_EXPIRES_IN=30m
# Email nguoi gui hien thi trong email dat lai mat khau - SMTP that duoc tro san toi container
# mailhog (dev/demo, xem service "mailhog" trong docker-compose.yml, xem lai email da "gui" tai
# http://localhost:8025) nen KHONG can khai bao SMTP_HOST/PORT/USER/PASSWORD o day.
SMTP_FROM=noreply@ecap-demo.local
# URL goc cua frontend (apps/web, container "web" map ra cong 80) - dung de dung link dat lai mat
# khau gui qua email. Doi thanh domain that khi trien khai ngoai dev.
FRONTEND_URL=http://localhost

# ---- Internal service-to-service auth (bo sung 21/07/2026, xem Technical_Spec.md muc 6/8) ----
# Gia tri bi mat dung chung giua Gateway va 5 service noi bo (IAM, Project-Task, Document,
# Notification, Analytics) - Gateway dinh kem header x-internal-secret, service phia sau bat
# buoc kiem tra khop truoc khi tin cac header context (x-org-id/x-user-id/x-roles/x-permissions).
# PHAI doi gia tri nay truoc khi dung that (khong dung gia tri mau trong moi truong khong phai dev).
INTERNAL_SHARED_SECRET=dev-shared-secret-change-me

# ---- CORS (bo sung 21/07/2026) ----
# Origin duy nhat duoc whitelist cho Gateway/IAM Service (thay the wildcard "*"). Gia tri duoi day
# khop voi cong dev-server mac dinh cua apps/web (Vite, xem apps/web/vite.config.ts). Khi build
# production that, doi thanh domain thuc te cua frontend.
CORS_ORIGIN=http://localhost:5173

# ---- Google Gemini API (bo sung 28/07/2026 - tinh nang "Nhan xet AI", Technical_Spec.md muc 4.7) ----
# Lay mien phi tai aistudio.google.com/apikey (khong can the tin dung). De trong se lam tinh nang
# nay tra loi loi ro rang (503) thay vi lam sap ca Analytics Service - cac tinh nang khac khong
# bi anh huong khi thieu key nay.
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-flash-latest

# ---- Groq API (bo sung 20/08/2026 - phuong an du phong TU DONG cho "Nhan xet AI") ----
# Lay mien phi tai console.groq.com/keys (khong can the tin dung). Dung khi Gemini o tren
# loi/qua tai (503) - AiInsightsService tu dong chuyen sang day, khong can thao tac gi them. De
# trong nghia la KHONG co du phong (tinh nang van chay, chi mat lop du phong khi Gemini qua tai).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Grafana (bo sung 04/08/2026 - Observability, Technical_Spec.md muc 15) ----
# Dev only - doi truoc khi dung ngoai moi truong dev (cung quy uoc voi JWT_ACCESS_SECRET).
# 25/08/2026: fix ra soat bao mat - gia tri vi du CU la "admin" (trung dung mat khau mac dinh cua
# chinh Grafana), khac voi moi mat khau dev khac trong file nay (vd redis_password, iam_password -
# yeu nhung KHONG PHAI 1 gia tri Grafana/cong cu quet tu dong nao cung thu dau tien). Doi sang 1
# gia tri yeu-nhung-khong-phai-mac-dinh-chuan, dung quy uoc voi phan con lai cua file.
GRAFANA_ADMIN_PASSWORD=grafana_admin_password
